# Copy this file to .env for local development. .env is ignored by git.
# This example file holds NAMES ONLY. Never put a real value in it.
#
# Secrets are read on the server only. A secret must NEVER start with VITE_:
# VITE_ values are sent to every browser. See src/lib/server-config.server.ts.

# --- Supabase (Phase 18). Create a free project at supabase.com. ---
# Project URL, for example https://abcdefgh.supabase.co
SUPABASE_URL=
# Public by design (it ships to browsers); row-level security protects the data.
SUPABASE_ANON_KEY=
# SECRET: bypasses row-level security. Server only; leave empty unless a job needs it.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI (Phase 18g) ---
# SECRET: Gemini API key. Put it here or in the hosting secret store, never in chat or issues.
GEMINI_API_KEY=

# --- Optional, public ---
# Comma separated feature flags switched on at build time, for example: labs
VITE_FLAGS=
# Public address of the site, for canonical links and sitemap.xml, for example https://skydeck.example (not a secret).
SITE_URL=
