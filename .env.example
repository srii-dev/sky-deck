# Copy this file to .env for local development. .env is ignored by git.
# This example file holds NAMES ONLY. Never put a real value in it.
#
# Secrets are read on the server only. A secret must NEVER start with VITE_:
# VITE_ values are sent to every browser. See src/lib/server-config.server.ts.

# --- Supabase (Phase 18). Create a free project at supabase.com. ---
# Project URL, for example https://abcdefgh.supabase.co
SUPABASE_URL=
# Public by design (it ships to browsers); row-level security protects the data.
SUPABASE_ANON_KEY=
# SECRET: bypasses row-level security. Server only; leave empty unless a job needs it.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI (Phase 18g) ---
# SECRET: Gemini API key. Put it here or in the hosting secret store, never in chat or issues.
GEMINI_API_KEY=

# --- Optional, public ---
# Comma separated feature flags set at build time, for example: labs  (a leading - switches one off: -acars, -satellite)
VITE_FLAGS=
# Public address of the site, for canonical links, sitemap.xml and link previews, for example https://skydeck.example (not a secret).
SITE_URL=
# off keeps the site out of search engines (X-Robots-Tag and a disallow-all robots.txt). Anything else, or unset, changes nothing (not a secret).
SITE_INDEXING=
# Upstream aircraft requests this server instance may spend per minute on optional refreshes (default 90, 0 for no limit).
# A starting guess: set it from what the data provider says it allows. See src/lib/refresh-budget.ts.
FEED_BUDGET_PER_MIN=
# Tests only: send ADS-B and route requests to the local stub (e2e/stub-upstream.mjs). Honoured only for
# http://localhost:<port> or http://127.0.0.1:<port>; Playwright sets it itself. Leave empty.
ADSB_UPSTREAM_OVERRIDE=
